| #if defined(__clang__)
| #pragma clang diagnostic push
| #pragma clang diagnostic ignored "-Wdeprecated-declarations"
| #endif
| 
| static int
| __archive_md5init(archive_md5_ctx *ctx)
| {
|   CC_MD5_Init(ctx);
|   return (ARCHIVE_OK);
| }
| 
| static int
| __archive_md5update(archive_md5_ctx *ctx, const void *indata,
