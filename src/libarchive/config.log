| static int
| win_crypto_Update(Digest_CTX *ctx, const unsigned char *buf, size_t len)
| {
| 
| 	if (!ctx->valid)
| 		return (ARCHIVE_FAILED);
| 
| 	BCryptHashData(ctx->hHash,
| 		      (PUCHAR)(uintptr_t)buf,
| 		      (ULONG)len, 0);
| 	return (ARCHIVE_OK);
| }
