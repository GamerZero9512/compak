| static int
| win_crypto_Final(unsigned char *buf, size_t bufsize, Digest_CTX *ctx)
| {
| 	if (!ctx->valid)
| 		return (ARCHIVE_FAILED);
| 
| 	BCryptFinishHash(ctx->hHash, buf, (ULONG)bufsize, 0);
| 	BCryptDestroyHash(ctx->hHash);
| 	BCryptCloseAlgorithmProvider(ctx->hAlg, 0);
| 	ctx->valid = 0;
| 	return (ARCHIVE_OK);
